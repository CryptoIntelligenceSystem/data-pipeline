BINANCE_FUTURES_BASE_URL=https://fapi.binance.com
BINANCE_SYMBOLS=BTCUSDT,ETHUSDT
BINANCE_INTERVAL=1m
BINANCE_LIMIT=100
BINANCE_HISTORY_LIMIT=1000
COINDESK_RSS_URL=https://www.coindesk.com/arc/outboundfeeds/rss/
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_MARKET_TOPIC=market_data
KAFKA_NEWS_TOPIC=news_data
COLLECTOR_OUTPUT_DIR=data/samples
COLLECTOR_POLL_SECONDS=60

# --- Spark jobs (forwarded by scripts/spark.ps1 / spark.sh; connections come from infrastructure/.env) ---
# Kafka offset used only on a job's first run (no checkpoint yet): earliest | latest
SPARK_STARTING_OFFSETS=earliest
# Per-job override example: MARKET_TO_CLICKHOUSE_STARTING_OFFSETS=latest
# SPARK_TRIGGER_INTERVAL=10 seconds
# SPARK_MAX_OFFSETS_PER_TRIGGER=10000
SPARK_FAIL_ON_DATA_LOSS=false
ANOMALY_PERIODS=20
ANOMALY_STDDEV_K=3
ANOMALY_LOOKBACK_HOURS=24
